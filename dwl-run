#!/bin/sh
# dwl session launcher
#
# Starts a dwl session with the environment this desktop needs, plus somebar on
# dwl's status stream. Run it from a TTY (or via wayland-sessions/dwl.desktop).
#
# Why this exists instead of a bare `dwl` call:
#   - Proton/Steam/Electron and Mozilla need the Wayland hints below to avoid
#     silently falling back to Xwayland.
#   - There is no systemd/elogind *user* session on Artix, so user services are
#     started here rather than by a user unit.
#   - dwl always picks the output's preferred mode, and DP-1's preferred mode is
#     60Hz on a 240Hz panel, so the mode is set explicitly once dwl is up.

# --- environment -------------------------------------------------------------
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=dwl
export MOZ_ENABLE_WAYLAND=1                 # librewolf
export ELECTRON_OZONE_PLATFORM_HINT=wayland # discord and other Electron apps
export __GLX_VENDOR_LIBRARY_NAME=nvidia     # Xwayland GLX -> the 3070
export LIBVA_DRIVER_NAME=nvidia             # VA-API decode for Xwayland apps

# --- user services -----------------------------------------------------------
pgrep -x pipewire       >/dev/null 2>&1 || pipewire       >/dev/null 2>&1 &
pgrep -x pipewire-pulse >/dev/null 2>&1 || pipewire-pulse >/dev/null 2>&1 &
pgrep -x wireplumber    >/dev/null 2>&1 || wireplumber    >/dev/null 2>&1 &

# --- gpu ---------------------------------------------------------------------
# This script can run before the NVIDIA modules have probed the card. At boot
# the kernel boots on simpledrm (the firmware framebuffer, exposed as card0) and
# only hands the console over to nvidia-drm (card1) a second or two later. dwl
# launched from tty1 autologin lands in that window: wlroots enumerates DRM
# cards once, tries to open card0 while the kernel is tearing it down, finds no
# usable GPU and exits with
#   Failed to open device: '/dev/dri/card0'
# by-path only lists real PCI devices, so this waits for our GPU and names it
# explicitly -- no race, and no chance of landing on simpledrm.
card=
tries=0
while [ -z "$card" ] && [ "$tries" -lt 20 ]; do
	for node in /dev/dri/by-path/*-card; do
		[ -e "$node" ] || continue
		card=$(readlink -f "$node")
		break
	done
	[ -z "$card" ] || break
	tries=$((tries + 1))
	sleep 1
done
if [ -n "$card" ]; then
	WLR_DRM_DEVICES=$card
	export WLR_DRM_DEVICES
fi

# --- session -----------------------------------------------------------------
# dwl's -s command owns dwl's stdout, and somebar reads that stream as its bar
# status. Everything started here must therefore keep stdout clean. dwl's own
# stderr goes to the log instead of the tty: a failed compositor used to scroll
# past on a console that the next session overwrites.
#
# dbus-run-session starts the session bus before dwl exists, so the bus never
# inherits WAYLAND_DISPLAY. Anything D-Bus activates (xdg-desktop-portal-wlr in
# particular) then cannot reach the compositor, and screen sharing silently gets
# no sources. The startup command below runs inside dwl's environment, which is
# the first point where WAYLAND_DISPLAY is known, so it publishes it to the bus.
mkdir -p "$HOME/.local/state"
LOG="$HOME/.local/state/dwl-run.log"
[ -f "$LOG" ] && tail -n 200 "$LOG" > "$LOG.new" && mv "$LOG.new" "$LOG"
{
	printf '\n=== session start: %s ===\n' "$(date -Is)"
	printf 'WLR_DRM_DEVICES=%s\n' "${WLR_DRM_DEVICES:-<unset: letting wlroots enumerate>}"
	ls -l /dev/dri /dev/dri/by-path 2>&1
	loginctl show-session "$XDG_SESSION_ID" -p Active -p Type -p State 2>&1 | tr '\n' ' '
	printf '\n'
} >> "$LOG"

DWL_STARTUP='dbus-update-activation-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_RUNTIME_DIR >>"$HOME/.local/state/dwl-run.log" 2>&1
refresh-mode >>"$HOME/.local/state/dwl-run.log" 2>&1
mako >/dev/null 2>&1 &
swaybg -i "$HOME/Images/Backgrounds/autumn-mountains.jpg" -m fill >/dev/null 2>&1 &
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 >/dev/null 2>&1 &
somebar-clock >/dev/null 2>&1 &
exec somebar'

dbus-run-session -- dwl -s "$DWL_STARTUP" 2>>"$LOG"
status=$?
if [ "$status" -ne 0 ]; then
	printf '\ndwl exited with status %s. Tail of %s:\n\n' "$status" "$LOG" >&2
	tail -n 25 "$LOG" >&2
fi
exit "$status"
